{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "smart-packaging-solutions",
  "main": "dist/server/index.js",
  "compatibility_date": "2025-05-28",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run build",
    "cwd": "."
  },
  "site": {
    "bucket": "./dist/client"
  }
}
